  "cues": [
    {
      "id": "hook1",
      "text": "Every airplane window has a *tiny hole* in it.",
      "start": 0.35,
      "end": 3.13
    },
    {
      "id": "hook2",
      "text": "You've probably sat *right next to one*",
      "start": 3.37,
      "end": 5.25
    },
    {
      "id": "hook3",
      "text": "and *never noticed.*",
      "start": 5.26,
      "end": 6.28
    },
    {
      "id": "nc1",
      "text": "It's not a *crack,*",
      "start": 6.55,
      "end": 7.58
    },
    {
      "id": "nc2",
      "text": "and it's not a *defect.*",
      "start": 7.59,
      "end": 9.13
    },
    {
      "id": "purp1",
      "text": "It's there *on purpose,*",
      "start": 9.31,
      "end": 10.77
    },
    {
      "id": "purp2",
      "text": "and it quietly does *two jobs.*",
      "start": 10.92,
      "end": 13.02
    },
    {
      "id": "ass1",
      "text": "Most people assume a plane window",
      "start": 13.41,
      "end": 15.25
    },
    {
      "id": "ass2",
      "text": "is *one thick sheet.*",
      "start": 15.26,
      "end": 16.54
    },
    {
      "id": "ass3",
      "text": "It's actually *three.*",
      "start": 16.83,
      "end": 18.11
    },
    {
      "id": "scr1",
      "text": "The pane you can touch",
      "start": 18.35,
      "end": 19.53
    },
    {
      "id": "scr2",
      "text": "is just a *scratch shield.*",
      "start": 19.54,
      "end": 20.98
    },
    {
      "id": "scr3",
      "text": "It holds back *no pressure* at all.",
      "start": 21.16,
      "end": 22.87
    },
    {
      "id": "pan1",
      "text": "Behind it sit two strong *acrylic panes:*",
      "start": 23.13,
      "end": 26.07
    },
    {
      "id": "pan2",
      "text": "a *middle* one and an *outer* one.",
      "start": 26.25,
      "end": 28.19
    },
    {
      "id": "alt1",
      "text": "At *cruising altitude,*",
      "start": 28.5,
      "end": 29.67
    },
    {
      "id": "alt2",
      "text": "the air outside is *thin.*",
      "start": 29.68,
      "end": 31.46
    },
    {
      "id": "alt3",
      "text": "The air inside is kept much *denser,*",
      "start": 31.62,
      "end": 34.03
    },
    {
      "id": "alt4",
      "text": "so it *pushes outward* on every window",
      "start": 34.19,
      "end": 36.68
    },
    {
      "id": "alt5",
      "text": "with *hundreds of kilos* of force.",
      "start": 36.69,
      "end": 38.71
    },
    {
      "id": "hole1",
      "text": "That *tiny hole*",
      "start": 38.92,
      "end": 40.03
    },
    {
      "id": "hole2",
      "text": "goes through the *middle pane.*",
      "start": 40.04,
      "end": 41.57
    },
    {
      "id": "flow1",
      "text": "Cabin air *flows into the gap* behind it,",
      "start": 41.85,
      "end": 44.16
    },
    {
      "id": "flow2",
      "text": "so the middle pane feels",
      "start": 44.26,
      "end": 45.54
    },
    {
      "id": "flow3",
      "text": "*equal pressure* on both sides.",
      "start": 45.55,
      "end": 47.43
    },
    {
      "id": "load1",
      "text": "The *outer pane* carries the whole load,",
      "start": 47.6,
      "end": 49.75
    },
    {
      "id": "load2",
      "text": "and the middle pane waits,",
      "start": 49.76,
      "end": 51.21
    },
    {
      "id": "load3",
      "text": "unstressed, as a *backup.*",
      "start": 51.42,
      "end": 53.02
    },
    {
      "id": "fog1",
      "text": "Job number two:",
      "start": 53.42,
      "end": 54.41
    },
    {
      "id": "fog2",
      "text": "that same airflow lets *moisture escape,*",
      "start": 54.72,
      "end": 57.18
    },
    {
      "id": "fog3",
      "text": "so the gap stays clear of *fog and frost.*",
      "start": 57.33,
      "end": 60.16
    },
    {
      "id": "end1",
      "text": "One *tiny hole.*",
      "start": 60.54,
      "end": 61.76
    },
    {
      "id": "end2",
      "text": "A *spare window* and a *defogger.*",
      "start": 62.01,
      "end": 64.03
    },
    {
      "id": "end3",
      "text": "What everyday thing",
      "start": 64.26,
      "end": 65.31
    },
    {
      "id": "end4",
      "text": "should we *unpack next?*",
      "start": 65.32,
      "end": 66.65
    }
  ]
}